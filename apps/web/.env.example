NEXT_PUBLIC_CBOR_ENDPOINT="https://laceanatomy.com/tx?_data=routes%2Ftx"
NEXT_PUBLIC_GA_TRACKING_ID="<Your-GA-Tracking-ID>"

# DATABASE URLS
DATABASE_URL="<Your-DB-URL>"
DIRECT_URL="<Your-Direct-URL>"

MAINNET_BLOCKFROST_KEY = "<Your-Mainnet-Blockfrost-Key>"
PREPROD_BLOCKFROST_KEY = "<Your-Preprod-Blockfrost-Key>"
PREVIEW_BLOCKFROST_KEY = "<Your-Preview-Blockfrost-Key>"

# Upstream call timeouts in milliseconds (optional, default 15000)
UPSTREAM_GRPC_TIMEOUT_MS=
UPSTREAM_HTTP_TIMEOUT_MS=

# Upstream cache caps in MB (optional, default 20% and 5% of the V8 heap limit)
UPSTREAM_CACHE_IMMUTABLE_MB=
UPSTREAM_CACHE_MUTABLE_MB=
# Lifetime of short-lived cache entries in milliseconds (optional, default 30000)
UPSTREAM_CACHE_TTL_MS=
# Set to 1 to log every lookup that reaches Dolos
UPSTREAM_REQUEST_LOG=
